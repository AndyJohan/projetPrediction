PORT=3001
HOST=127.0.0.1
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT=1mb

API_KEY_REQUIRED=true
API_KEY=replace-with-a-long-random-secret
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120

DB_HOST=localhost
DB_PORT=5432
DB_USER=prediction_app
DB_PASSWORD=replace-with-database-password
DB_NAME=prediction
DB_SSL=false
DB_SSL_REJECT_UNAUTHORIZED=true

ML_SERVICE_DIR=../ml-service
ML_INFERENCE_TIMEOUT_MS=15000
ML_MAX_CONCURRENCY=2
ML_MAX_OUTPUT_BYTES=64000

OPENROUTER_API_KEY=replace-with-openrouter-key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openrouter/free
OPENROUTER_REFERER=http://localhost:3000
ASSISTANT_INCLUDE_DB_CONTEXT=false
